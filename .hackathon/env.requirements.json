{
  "schema_version": 1,
  "services": [
    {
      "service": "OpenRouter",
      "required_for": "Jev (typesafe/jev-1.14) System One decisions",
      "variables": [
        {
          "name": "OPENROUTER_API_KEY",
          "secret": true,
          "required": true
        }
      ]
    },
    {
      "service": "Gemini API",
      "required_for": "Gemini calls (default gemini-3.6-flash)",
      "variables": [
        {
          "name": "GEMINI_API_KEY",
          "secret": true,
          "required": false
        }
      ]
    },
    {
      "service": "Tiger Data",
      "required_for": "hypertable log of gate decisions",
      "variables": [
        {
          "name": "DATABASE_URL",
          "secret": true,
          "required": false
        }
      ]
    },
    {
      "service": "Bright Data",
      "required_for": "live web search and fetch through the Bright Data MCP",
      "variables": [
        {
          "name": "BRIGHTDATA_API_KEY",
          "secret": true,
          "required": false
        }
      ]
    }
  ],
  "notes": [
    "No value belongs in Git.",
    "Other sponsor integrations are not selected yet and therefore are not listed."
  ]
}
